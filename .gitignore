__pycache__/
*.pyc
.venv
.venv/
.env
.DS_Store
runs/

# graphify: outputs + the ledger and manifest are tracked; only the machine-local
# working state (extraction cache, resolved interpreter path, scan root) is not.
graphify-out/*
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/cost.json
!graphify-out/manifest.json

# ADR-037 §4: EVAL_PROBE=1 runs write here instead of the committed ledger.
evals/report/history-probe.jsonl
