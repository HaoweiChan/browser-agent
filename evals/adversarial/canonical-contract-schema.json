    "accept": [
      {"label": "deterministic loud failure", "state": {"node": "decide", "route": "failure", "status": "failure:extract", "verifier": {"authority": "deterministic", "verdict": "FAIL"}, "retry": {"used": 1, "limit": 1}, "budgets": {"calls": 0, "tokens": 0, "usd": 0, "ms": 0}, "evidence": []}}
